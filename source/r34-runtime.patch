+def _duplicate_context_wkv_weights(weights, num_layers):
+    """Feed the SAME checkpoint weights/scales to both quantized projections."""
+    for name, weight in weights:
+        yield name, weight
+        match = _CONTEXT_WKV_RE.fullmatch(name)
