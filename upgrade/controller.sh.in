#!/usr/bin/env bash
set -euo pipefail
umask 077
old_container=''
old_id=''
old_was_running=false
prior_candidate_id=''
new_container=dsv4-flash-r34
new_owner=deepseek-v4-flash-r3.4-20260916
say(){ printf '%s\n' "$*"; }
fail(){ say "ERROR: $*" >&2; exit 1; }
for command in docker base64 gzip sha256sum flock timeout realpath mktemp tee; do
  command -v "$command" >/dev/null || fail "Missing command: $command"
done
if docker info >/dev/null 2>&1; then up_docker=(docker)
elif sudo -n docker info >/dev/null 2>&1; then up_docker=(sudo -n docker)
else fail 'Docker access unavailable'; fi
up_dc(){ "${up_docker[@]}" "$@"; }
up_running(){ [[ $(up_dc inspect --format '{{.State.Running}}' "$1" 2>/dev/null) == true ]]; }
valid_previous_owner(){
  case "$1" in deepseek-v4-flash-r3.3-20260914|deepseek-v4-flash-r3.2-20260914|deepseek-v4-flash-r3.1-20260913) return 0 ;; *) return 1 ;; esac
}
select_image(){
  local reference=$1 expected_release
  base_id=$(up_dc image inspect --format '{{.Id}}' "$reference") || fail 'Existing runtime image is unavailable'
  case "$base_id" in
    sha256:2a444d5ffd042ea154c14da4b8dc2ad2121226c2869b12bbeb4358680080132d|sha256:64cc83da4129dbddb6d040ebc5a9a9038071257d82d62b831c3c782e1b097e49) expected_release=2026.09.10-r3-vision-rc1 ;;
    sha256:272c73e1e38aa508b9424ff472b391eef41b28503f884c5659584c39362ae188|sha256:643a42d2f008dbb4e2f1f5a1b36b1e1ccad3f8e6dee747b19240756151450137) expected_release=2026.09.13-r3.1 ;;
    sha256:337f3aa9ea8b7bcc189e9ccc286caae02bf9b6c722d72334f1bb204d0fdb1f72|sha256:f1031202f20adb8510378235daefca6af3159f911e4cf6f3bc95152a6e4ebc00) expected_release=2026.09.14-r3.2 ;;
    sha256:3a93108b2925da6d5498f2a7f7c442159b7a14fc0d6e64da3bbcc5b0a3a338e9) expected_release=2026.09.14-r3.3 ;;
    *) fail 'Existing runtime image ID is not a frozen R3 / R3.1 / R3.2 / R3.3 image; no service changed' ;;
  esac
  [[ $(up_dc image inspect --format '{{index .Config.Labels "com.deepseek.release"}}' "$base_id") == "$expected_release" ]] || fail 'Existing runtime image release label mismatch'
  base_image=$base_id
}
if up_dc container inspect "$new_container" >/dev/null 2>&1; then
  if [[ $(up_dc inspect --format '{{index .Config.Labels "com.deepseek.owner"}}' "$new_container") == "$new_owner" ]] && up_running "$new_container"; then
    up_dc exec "$new_container" /opt/r3/bin/python /deploy/scripts/effective_state.py
    say 'R34_UPGRADE=ALREADY_CURRENT MODEL=DeepSeek-V4-Flash; no restart needed'
    exit 0
  fi
  [[ $(up_dc inspect --format '{{index .Config.Labels "com.deepseek.owner"}}' "$new_container") == "$new_owner" ]] || fail 'R3.4 name belongs to another service'
  [[ $(up_dc inspect --format '{{.State.Status}}' "$new_container") == exited || $(up_dc inspect --format '{{.State.Status}}' "$new_container") == created ]] || fail 'Existing R3.4 container is not stopped'
  prior_candidate_id=$(up_dc inspect --format '{{.Id}}' "$new_container")
fi
source_hint=${R34_SOURCE_DIR:-}
if [[ -n $source_hint ]]; then source_hint=$(realpath -e -- "$source_hint"); fi
candidates=()
active_candidates=()
known=(dsv4-flash-r33 dsv4-flash-r32 dsv4-flash-r31 dsv4-vision-r3-scheme4 dsv4-vision-r3-scheme2 dsv4-vision-r3-scheme3 dsv4-vision-r3-scheme1)
for candidate in "${known[@]}"; do
  up_dc container inspect "$candidate" >/dev/null 2>&1 || continue
  candidate_dir=$(up_dc inspect --format '{{range .Mounts}}{{if eq .Destination "/deploy"}}{{.Source}}{{end}}{{end}}' "$candidate")
  [[ -d $candidate_dir ]] || continue
  candidate_dir=$(realpath -e -- "$candidate_dir")
  if [[ -n $source_hint && $candidate_dir != "$source_hint" ]]; then continue; fi
  candidate_state=$(up_dc inspect --format '{{.State.Status}}' "$candidate")
  case "$candidate_state" in running|exited|created) ;; *) fail "Previous container is $candidate_state: $candidate" ;; esac
  candidates+=("$candidate")
  if [[ $candidate_state == running ]]; then active_candidates+=("$candidate"); fi
done
if (( ${#active_candidates[@]} > 1 )); then fail 'Multiple matching model services are running; no changes made'
elif (( ${#active_candidates[@]} == 1 )); then old_container=${active_candidates[0]}
elif (( ${#candidates[@]} == 1 )); then old_container=${candidates[0]}
elif (( ${#candidates[@]} > 1 )); then
  for preferred in "${known[@]}"; do
    for candidate in "${candidates[@]}"; do
      if [[ $candidate == "$preferred" ]]; then old_container=$candidate; break 2; fi
    done
  done
  [[ -n $old_container ]] || fail 'Multiple stopped prior deployments; set R34_SOURCE_DIR explicitly'
fi
if [[ -n $old_container ]]; then
  old_owner=$(up_dc inspect --format '{{index .Config.Labels "com.deepseek.owner"}}' "$old_container")
  # Raw R3 owner labels vary. Only the exact legacy names plus frozen image
  # content IDs and deployment/model mounts are accepted for that generation.
  case "$old_container" in
    dsv4-vision-r3-scheme[1234]) ;;
    *) valid_previous_owner "$old_owner" || fail 'Previous container owner mismatch' ;;
  esac
  old_id=$(up_dc inspect --format '{{.Id}}' "$old_container")
  old_image=$(up_dc inspect --format '{{.Image}}' "$old_container")
  select_image "$old_image"
  old_was_running=$(up_dc inspect --format '{{.State.Running}}' "$old_container")
  old_dir=$(up_dc inspect --format '{{range .Mounts}}{{if eq .Destination "/deploy"}}{{.Source}}{{end}}{{end}}' "$old_container")
  model_dir=$(up_dc inspect --format '{{range .Mounts}}{{if eq .Destination "/model"}}{{.Source}}{{end}}{{end}}' "$old_container")
  cache_dir=$(up_dc inspect --format '{{range .Mounts}}{{if eq .Destination "/runtime-cache"}}{{.Source}}{{end}}{{end}}' "$old_container")
else
  if [[ -z $source_hint && -f $PWD/start.sh && -f $PWD/scripts/engine.py ]]; then source_hint=$PWD; fi
  [[ -n $source_hint ]] || fail 'No prior R3-series container found. Run in its deployment directory or set R34_SOURCE_DIR'
  old_dir=$source_hint
  [[ -f $old_dir/start.sh && -f $old_dir/scripts/engine.py ]] || fail 'Incomplete prior deployment directory'
  base_image=''
  for reference in dsv4-flash-a100:20260914-r3.3 dsv4-flash-a100:20260914-r3.2 dsv4-flash-a100:20260913-r3.1 dsv4-vision-a100:20260910-r3-sm80-rc1; do
    if up_dc image inspect --format '{{.Id}}' "$reference" >/dev/null 2>&1; then select_image "$reference"; break; fi
  done
  [[ -n $base_image ]] || fail 'No frozen runtime image found; use the full offline R3.4 package'
fi
old_dir=$(realpath -e -- "$old_dir")
[[ -w $old_dir && -f $old_dir/start.sh && -f $old_dir/scripts/engine.py ]] || fail 'Original deployment directory is not writable or incomplete'
# This is the operator's existing local configuration. Do not execute old start.sh.
load_disk_config(){
  local MODEL_DIR='' R3_API_KEY='' R3_RUNTIME_DIR=''
  if [[ -f $old_dir/deployment.env ]]; then source "$old_dir/deployment.env"; fi
  disk_model_dir=${MODEL_DIR:-/ai/models/deepseek-v4-flash-vision-exp-modelscope}
  old_runtime=${R3_RUNTIME_DIR:-$old_dir/runtime}
}
load_disk_config
if [[ -z $old_container ]]; then
  model_dir=$disk_model_dir
  cache_dir=$old_runtime/cache
fi
unset R3_API_KEY VLLM_API_KEY
[[ $old_runtime == /* && $cache_dir == /* ]] || fail 'Runtime and cache paths must be absolute'
mkdir -p "$old_runtime/control" "$cache_dir"
for directory in "$old_dir" "$model_dir" "$cache_dir" "$old_runtime"; do
  [[ $directory == /* && -d $directory && $directory != *','* && $directory != *$'\n'* ]] || fail 'Invalid original mount directory'
done
exec 6>"$old_runtime/control/cache-memory-hf5.lock"
flock -n 6 || fail 'An earlier memory/cache update is running'
exec 7>"$old_runtime/control/tokenizer-hf6.lock"
flock -n 7 || fail 'An earlier tokenizer update is running'
exec 8>"$old_runtime/control/start-stop.lock"
flock -n 8 || fail 'An earlier deployment operation is running'
for other in dsv4-flash-r33 dsv4-flash-r32 dsv4-flash-r31 dsv4-vision-r3-scheme1 dsv4-vision-r3-scheme2 dsv4-vision-r3-scheme3 dsv4-vision-r3-scheme4; do
  [[ $other != "$old_container" ]] || continue
  if up_running "$other"; then fail "Another model service is running: $other"; fi
done
say "UPGRADE_ENTRYPOINT=R3.4 AUTH=DISABLED PREVIOUS_CONTAINER=${old_container:-ABSENT} PREVIOUS_RUNNING=$old_was_running SOURCE=$old_dir"
if [[ $old_was_running == true ]]; then
  up_dc exec "$old_container" /opt/r3/bin/python -c 'import json,urllib.request; d=json.load(urllib.request.urlopen("http://127.0.0.1:8005/v1/models",timeout=30))["data"]; assert d and all(x["max_model_len"]==262144 for x in d); print("PREVIOUS_HEALTH=PASS")'
else
  say 'PREVIOUS_HEALTH=SKIP (previous service is stopped or absent; it will not be started as a prerequisite)'
fi
stamp=$(date +%Y%m%d-%H%M%S)-$$
report="$old_runtime/control/r34-upgrade-$stamp"
mkdir -p "$report"
exec > >(tee "$report/run.log") 2>&1
new_dir=$(mktemp -d "$old_dir/r3.4-image999-$stamp-XXXXXX")
assets=$(mktemp -d "$old_dir/.r34-payload-$stamp-XXXXXX")
switch_started=0
completed=0
phase_pid=''
restore_previous(){
  local rc=0
  say 'UPGRADE_FAILED: stopping the candidate and restoring the previous service state'
  if up_dc container inspect "$new_container" >/dev/null 2>&1; then
    [[ $(up_dc inspect --format '{{index .Config.Labels "com.deepseek.owner"}}' "$new_container") == "$new_owner" ]] || return 1
    [[ $(up_dc inspect --format '{{range .Mounts}}{{if eq .Destination "/deploy"}}{{.Source}}{{end}}{{end}}' "$new_container") == "$new_dir" ]] || return 1
    up_dc logs --timestamps --tail 350 "$new_container" > "$report/candidate-failure.log" 2>&1 || true
    up_dc stop --time 90 "$new_container" >/dev/null || rc=1
    local candidate_running
    candidate_running=$(up_dc inspect --format '{{.State.Running}}' "$new_container") || return 1
    [[ $candidate_running == false ]] || return 1
  fi
  if [[ $old_was_running != true ]]; then
    say "RESTORE_PREVIOUS=PASS PREVIOUS_RUNNING=false PREVIOUS_CONTAINER=${old_container:-ABSENT}; previous files and stopped containers retained"
    return "$rc"
  fi
  [[ $(up_dc inspect --format '{{.Id}}' "$old_container") == "$old_id" ]] || return 1
  up_dc start "$old_container" >/dev/null || return 1
  for ((attempt=0;attempt<120;attempt++)); do
    if ! up_running "$old_container"; then return 1; fi
    if up_dc exec "$old_container" /opt/r3/bin/python -c 'import json,urllib.request; d=json.load(urllib.request.urlopen("http://127.0.0.1:8005/v1/models",timeout=30))["data"]; assert d and all(x["max_model_len"]==262144 for x in d); print("PREVIOUS_HEALTH=PASS")' >/dev/null 2>&1; then
      say 'RESTORE_PREVIOUS=PASS; restored previous configuration, not the failed candidate'
      return "$rc"
    fi
    ((attempt%6)) || say "RESTORING_PREVIOUS_WAIT_SECONDS=$((attempt*10))"
    sleep 10
  done
  return 1
}
finish(){
  local rc=$? restore_rc=0
  trap - EXIT INT TERM
  set +e
  if [[ -n $phase_pid ]]; then
    kill -TERM "$phase_pid" 2>/dev/null
    wait "$phase_pid" 2>/dev/null
  fi
  if (( ! completed )); then
    (( rc )) || rc=1
    if (( switch_started )); then
      restore_previous || restore_rc=$?
      say "RESTORE_PREVIOUS_RC=$restore_rc"
    else
      say 'PREVIOUS_SERVICE_UNCHANGED=YES'
    fi
    say "R34_UPGRADE=FAIL RC=$rc REPORT=$report CANDIDATE=$new_dir"
  fi
  rm -f -- "$assets/installer.py" "$assets/payload.json"
  rmdir -- "$assets" 2>/dev/null
  exit "$rc"
}
trap finish EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
@@PAYLOAD_FILES@@
up_dc run --rm --pull never --network none --user "$(id -u):$(id -g)" \
  --mount "type=bind,src=$assets,dst=/upgrade,readonly" \
  --mount "type=bind,src=$old_dir,dst=/old,readonly" \
  --mount "type=bind,src=$new_dir,dst=/new" \
  --entrypoint /opt/r3/bin/python "$base_image" /upgrade/installer.py /new /upgrade/payload.json "$model_dir" "$cache_dir" "$base_image"
(cd "$new_dir" && sha256sum --check --quiet FILES.sha256)
# Validate full checkpoint headers and CPU regressions before stopping the service.
up_dc run --rm --pull never --network none --user "$(id -u):$(id -g)" \
  --mount "type=bind,src=$new_dir,dst=/deploy,readonly" --mount "type=bind,src=$model_dir,dst=/model,readonly" \
  --entrypoint /opt/r3/bin/python "$base_image" /deploy/scripts/verify_model.py /model > "$report/model-headers.json"
up_dc run --rm --pull never --network none --env PYTEST_DISABLE_PLUGIN_AUTOLOAD=1 --user "$(id -u):$(id -g)" \
  --mount "type=bind,src=$new_dir,dst=/deploy,readonly" \
  --entrypoint /opt/r3/bin/python "$base_image" -m pytest -q -p no:cacheprovider /deploy/tests/test_r34_runtime.py
printf '%s\n' "PREVIOUS_CONTAINER=${old_container:-ABSENT}" "PREVIOUS_ID=$old_id" "PREVIOUS_RUNNING=$old_was_running" "BASE_IMAGE_ID=$base_id" "INSTALL_DIR=$new_dir" > "$report/upgrade-state.txt"
# A concrete manual rollback also remains available after successful promotion.
{
  printf '#!/usr/bin/env bash\nset -euo pipefail\n'
  printf 'previous_container=%q\nprevious_id=%q\nprevious_running=%q\n' "$old_container" "$old_id" "$old_was_running"
  cat <<'R34_ROLLBACK_END'
source "$(dirname -- "$0")/scripts/lib.sh"
check_image
if [[ -n $previous_container ]]; then
  [[ $(dc inspect --format '{{.Id}}' "$previous_container") == "$previous_id" ]] || die 'Previous container changed or was removed; current service unchanged'
fi
bash "$PACKAGE_DIR/stop.sh"
if [[ $previous_running == true ]]; then
  dc start "$previous_container" >/dev/null
  log "ROLLBACK_STARTED=$previous_container; check previous deployment health while it loads"
else
  log 'ROLLBACK=PASS; previous deployment was stopped/absent and remains so'
fi
R34_ROLLBACK_END
} > "$new_dir/rollback.sh"
chmod 700 "$new_dir/rollback.sh"
(cd "$new_dir" && sha256sum rollback.sh >> FILES.sha256)
mkdir -p "$new_dir/runtime/results"
say "R34_PREPARED=YES INSTALL_DIR=$new_dir"
say 'FIXED: DeepSeek-V4-Flash DSpark-k6 V2+Graph 0.92 262144 C32 image=999 AUTH=DISABLED'
if [[ -n $old_container ]]; then
  [[ $(up_dc inspect --format '{{.Id}}' "$old_container") == "$old_id" ]] || fail 'Previous container changed during preparation'
  [[ $(up_dc inspect --format '{{.State.Running}}' "$old_container") == "$old_was_running" ]] || fail 'Previous service state changed during preparation'
fi
# Same payload, output budget and client for a sustained C1 before/after record.
# Measurement failures/early EOS are retained, never invented as speedups.
if [[ $old_was_running == true ]]; then
  say 'MEASURING_PREVIOUS_C1_TEXT_AND_IMAGE'
  up_dc run --rm --pull never --network bridge --add-host host.docker.internal:host-gateway \
    --env R34_BENCH_DISCOVER=1 --user "$(id -u):$(id -g)" \
    --mount "type=bind,src=$new_dir,dst=/deploy,readonly" \
    --mount "type=bind,src=$new_dir/runtime/results,dst=/results" \
    --entrypoint /opt/r3/bin/python "$base_image" /deploy/scripts/performance.py \
    2>&1 | tee "$report/performance-before.log" || say 'BASELINE_BENCHMARK=UNAVAILABLE'
fi
if [[ -n $prior_candidate_id ]]; then
  [[ $(up_dc inspect --format '{{.Id}}' "$new_container") == "$prior_candidate_id" ]] && ! up_running "$new_container" || fail 'Prior candidate changed during preparation'
  up_dc rename "$new_container" "$new_container-failed-$stamp"
fi
switch_started=1
if [[ $old_was_running == true ]]; then
  say "STOPPING_PREVIOUS_SERVICE=$old_container"
  up_dc stop --time 90 "$old_container" >/dev/null
fi
run_phase(){
  local rc=0
  timeout --signal=TERM --kill-after=20s 2400 bash "$new_dir/$1" &
  phase_pid=$!
  wait "$phase_pid" || rc=$?
  phase_pid=''
  return "$rc"
}
say 'CHECKING_R34_GPU_KERNELS'
run_phase gpu_kernel_test.sh
say 'STARTING_R34'
run_phase start.sh
say 'VERIFYING_R34_PROTOCOLS_CACHE_IMAGES_C32_LONG_CONTEXT'
run_phase verify.sh
run_phase performance_test.sh > "$report/performance-after.log" 2>&1
cat "$report/performance-after.log"
up_dc run --rm --pull never --network none --user "$(id -u):$(id -g)" \
  --mount "type=bind,src=$new_dir,dst=/deploy,readonly" --mount "type=bind,src=$report,dst=/report,readonly" \
  --entrypoint /opt/r3/bin/python "$base_image" /deploy/scripts/compare_performance.py
completed=1
say "R34_UPGRADE=PASS MODEL=DeepSeek-V4-Flash MEMORY=0.92 CONTEXT=262144 CONCURRENCY=32 IMAGE_LIMIT=999 DEFAULT=DSpark-k6-V2-Graph AUTH=DISABLED INSTALL_DIR=$new_dir REPORT=$report"
say 'Previous files and any previous container are retained. Future operations: use start.sh / stop.sh / verify.sh in INSTALL_DIR, without a scheme number.'
say 'NEWAPI_WIRE_AND_BILLING=NOT_TESTED; optional newapi_test.sh is included with instructions in NEWAPI.md'
